{
  "manifest_version": 3,
  "name": "Velo - YouTube Downloader & AI Transcript Studio",
  "version": "1.0.0",
  "description": "Download YouTube videos in 1080p/4K & high-bitrate audio, extract transcripts, generate AI summaries, and queue videos for later.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "cookies",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "https://youtube.com/*",
    "https://*.googlevideo.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.grok-sandbox.com/*",
    "https://*.grok.com/*",
    "https://grok.me/*",
    "https://*.grok.me/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Velo YouTube Downloader & Transcript Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
